# ==============================================================================
# NephroAI / KiTS23 Clinical Segmentation - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caching & Performance Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# ------------------------------------------------------------------------------
# 3. Large Deep Learning Model Weights & Checkpoints (>50MB-100MB)
# ------------------------------------------------------------------------------
# PyTorch, ONNX, and TensorRT weights exceed GitHub 100MB limits
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.engine
*.h5
*.safetensors
*.pb

# Checkpoint directories
checkpoints/
**/checkpoints/
legacy_models/
archive_legacy/

# ------------------------------------------------------------------------------
# 4. Medical Imaging Datasets & Volume Archives
# ------------------------------------------------------------------------------
# Large medical CT datasets (KiTS23 dataset is tens of gigabytes)
dataset/
data/
archive/
archive_legacy/
*.nii
*.nii.gz
*.mha
*.mhd
*.dcm
*.npy
*.npz
*.hdf5

# ------------------------------------------------------------------------------
# 5. Generated Evaluation Reports, Visualizations & Run Timelines
# ------------------------------------------------------------------------------
# Automated CLI evaluation runs generate large volumes of PNG overlays & reports
reports/
**/reports/timeline/
runs/
evaluation_results/

# ------------------------------------------------------------------------------
# 6. User Uploads & Dynamic Server Data
# ------------------------------------------------------------------------------
uploaded_cases/
uploads/

# ------------------------------------------------------------------------------
# 7. Frontend (React / Vite / Node.js) Dependencies & Builds
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 8. Jupyter Notebook Checkpoints & Cache
# ------------------------------------------------------------------------------
.ipynb_checkpoints
**/.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 9. IDEs, Operating System & Editor Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
tempCodeRunnerFile.py
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# 10. Secrets, Local Configurations & Scratch Notes
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
prompts.txt
scratch/
